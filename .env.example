# Earnings Intelligence Platform: environment template
# Copy to .env and fill in. .env is gitignored; never commit real keys.

# ---- Default (local) backend ----
OPENAI_API_KEY=sk-...
SEC_EDGAR_USER_AGENT=YourName research@example.com   # SEC requires identification

# ---- Backend switch ----
# local (default) = ChromaDB + sentence-transformers + OpenAI
# azure           = Azure AI Search + Azure OpenAI
EIP_BACKEND=local

# ---- Azure backend (only needed when EIP_BACKEND=azure) ----
# Azure OpenAI (create a resource, then deploy a chat model and an embedding model;
# the deployment NAMES go in configs/default.yaml under azure.openai.*)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# Azure AI Search (create a service; an F1 free tier is enough to try)
AZURE_SEARCH_ENDPOINT=https://<your-service>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=earnings-filings
